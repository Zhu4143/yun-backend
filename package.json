{
  "name": "yun-liquid-ui-react",
  "private": true,
  "version": "1.0.5",
  "description": "昀 - 沉浸式智能音乐助手",
  "author": "zhudo",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server.js",
    "desktop-agent": "npm --prefix yun-desktop-agent start",
    "wechat-listener": "python yun-desktop-agent/wechat-listener/wechat_listener.py",
    "yun:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-yun.ps1 -DebugOcr",
    "yun:start:no-wechat": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-yun.ps1 -NoWechat",
    "build": "vite build",
    "test:moss": "node --test server/agent/mossAgent.test.js",
    "test:telemetry": "node --test src/telemetry/logic.test.js src/telemetry/commandObserver.test.js server/telemetry/telemetry.test.js",
    "test:discovery": "node --test server/discovery/index.test.js",
    "test:feedback": "node --test server/discovery/feedbackLoop.test.js",
    "test:core": "node --test server/yun-agent/core/toolRegistry.test.js server/yun-agent/core/permission.test.js server/yun-agent/core/stateStore.test.js server/yun-agent/core/memoryStore.test.js server/yun-agent/core/index.test.js server/yun-agent/agentLoop.test.js server/yun-agent/skillMining.test.js",
    "test:player": "node --test src/player/playerTypes.test.js src/player/audio/AudioEngine.test.js src/player/adapters/yunLegacyPlayerAdapter.test.js src/player/react/usePlayer.test.js src/player/listening/ListeningSessionTracker.test.js src/player/listening/ListeningEventReporter.test.js src/player/listening/PauseSuppressionGate.test.js src/player/listening/HardPlaybackRequestGate.test.js src/player/listening/CrossfadeRequestLifecycle.test.js",
    "test:music-memory": "node --test server/music-memory/musicMemory.test.js server/music-memory/http.test.js server/music-memory/preferenceAggregator.test.js server/music-memory/chatContext.test.js server/music-memory/writeIsolation.test.js",
    "test:netease-session": "node --test server/netease/accountSessionService.test.js",
    "test:netease-history-sync": "node --test server/netease/listeningHistorySyncService.test.js",
    "test:voice": "node --test src/voice/VoiceSessionController.test.mjs src/voice/audio/EchoCanceller.test.mjs server/asr/asrService.test.mjs",
    "test:services": "node --test server/agent/modelProvider.test.js server/cowagentBridge.test.js server/music-intelligence/transitionPlanner.test.js server/netease/capabilityService.test.js src/api/neteaseApi.test.js src/api/smartMusicApi.test.js src/services/netease/capabilityArchitecture.test.js src/services/netease/capabilityTruth.test.js src/services/chatIntentRouter.test.js src/services/radioEngine.test.js src/services/musicPreferenceRanker.test.js src/services/yunAgentActions.test.js src/services/yunAgentReply.test.js",
    "test:e2e:conversation": "node scripts/yun-conversation-e2e.mjs",
    "test:e2e:netease": "node scripts/yun-conversation-e2e.mjs --real",
    "lint": "eslint .",
    "verify": "npm run lint && npm run test:player && npm run test:music-memory && npm run test:netease-session && npm run test:netease-history-sync && npm run test:voice && npm run test:telemetry && npm run test:services && npm run test:e2e:conversation && npm run test:discovery && npm run test:feedback && npm run test:core && npm run test:moss && npm run build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@pixiv/three-vrm": "^3.5.3",
    "@pixiv/three-vrm-animation": "^3.5.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "dotenv": "^17.4.2",
    "liquid-glass-react": "^1.1.1",
    "multer": "^2.2.0",
    "music-metadata": "^11.12.3",
    "NeteaseCloudMusicApi": "^4.32.0",
    "openai": "^6.45.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "com.yun.musicassistant",
    "productName": "昀",
    "electronDist": ".electron-dist-cache",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/music-metadata/**",
      "node_modules/NeteaseCloudMusicApi/**"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*.js",
      "server/**/*.json",
      "server/**/*.md",
      "server.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server/data",
        "to": "default-data",
        "filter": [
          "manualMusicTags.json",
          "musicLibrary.json",
          "yunMemory.json",
          "yunSettings.json"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ],
      "artifactName": "Yun-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "昀"
    }
  }
}
