PORT=3030
YUN_BACKEND_URL=http://localhost:3030
MUSIC_DIR=C:\Users\zhudo\Music\音乐
LYRICS_DIR=C:\Users\zhudo\yun-liquid-ui-react\歌词
YUN_LEGACY_BACKEND_DIR=C:\Users\zhudo\Documents\Codex\2026-05-28\claude-ai-api-doctype-html-html

DEEPSEEK_API_KEY=sk-your-key-here
# Flash handles fast structured decisions; Pro handles deep companion and agent work.
# Override these only when your API provider gives you a different endpoint or model name.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# Backward-compatible alias for DEEPSEEK_PRO_MODEL.
DEEPSEEK_MODEL=deepseek-v4-pro

# MOSS provider adapter. Keep these values only in a local .env file; never expose them to Vite/browser code.
# AI_PROVIDER=openai-compatible
# AI_API_KEY=replace-with-local-secret
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1-mini
# AI_TEMPERATURE=0.3

DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3-vl-plus

DOUBAO_TTS_API_KEY=your_api_key_here
DOUBAO_TTS_RESOURCE_ID=your_resource_id_here
DOUBAO_TTS_SPEAKER=your_speaker_id_here
DOUBAO_TTS_FORMAT=mp3
DOUBAO_TTS_SAMPLE_RATE=24000

# Local GPU speech stack. Set these after running scripts\install-local-speech.ps1.
# It keeps TTS and ASR on 127.0.0.1; no API key or audio leaves this computer.
# YUN_TTS_PROVIDER=local-qwen3
# YUN_LOCAL_SPEECH_URL=http://127.0.0.1:17892
# The 0.6B variant is the safe default for 8 GB GPUs; move to 1.7B only after
# confirming it fits alongside your display workload.
# QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
# QWEN_TTS_SPEAKER=Vivian
# QWEN_TTS_INSTRUCT=用温柔、自然、陪伴感强的女声说话，语速稍慢。
# ASR_PROVIDER=local-sensevoice
# Keep SenseVoice on CPU on 8 GB GPUs so Qwen TTS can remain loaded on GPU.
# YUN_ASR_DEVICE=cpu
# SENSEVOICE_MODEL=iic/SenseVoiceSmall

# Optional bootstrap only. The MOSS UI can configure these locally without
# exposing the key to the browser, and persists them in a Git-ignored file.
# MOSS_DOUBAO_TTS_API_KEY=your_doubao_api_key_here
# MOSS_DOUBAO_TTS_VOICE_ID=S_your_cloned_voice_id
# MOSS_DOUBAO_TTS_RESOURCE_ID=seed-icl-2.0
